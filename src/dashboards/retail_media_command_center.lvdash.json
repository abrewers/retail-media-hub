{
  "datasets": [
    {
      "name": "campaign_delivery",
      "displayName": "Campaign delivery (metric view)",
      "queryLines": [
        "SELECT `Campaign Name` AS campaign_name, `Advertiser` AS advertiser, `Region` AS region,\n",
        "       `Campaign Status` AS campaign_status, `Risk Level` AS risk_level, `Days Remaining` AS days_remaining,\n",
        "       MEASURE(`Contracted Impressions`) AS contracted_impressions,\n",
        "       MEASURE(`Delivered Impressions`) AS delivered_impressions,\n",
        "       MEASURE(`Shortfall Dollars`) AS shortfall_dollars,\n",
        "       MEASURE(`Delivery Rate`) / 100 AS delivery_rate,\n",
        "       MEASURE(`Pace Adjusted Pct`) / 100 AS pace_pct,\n",
        "       CASE WHEN `Risk Level` IN ('Critical', 'At Risk') THEN 1 ELSE 0 END AS at_risk_flag,\n",
        "       CASE WHEN `Risk Level` = 'Over-Delivering' THEN 1 ELSE 0 END AS over_delivering_flag\n",
        "FROM metric_view_campaign_delivery\n",
        "GROUP BY ALL\n",
        "ORDER BY shortfall_dollars DESC\n"
      ]
    },
    {
      "name": "site_weekly",
      "displayName": "Weekly delivery drivers by region (metric view)",
      "queryLines": [
        "SELECT `Impression Week` AS week, `Region` AS region,\n",
        "       MEASURE(`Impressions`) AS impressions,\n",
        "       MEASURE(`Screen Uptime Pct`) / 100 AS uptime,\n",
        "       MEASURE(`Impressions Lost to Downtime`) AS lost_impressions\n",
        "FROM metric_view_site_delivery\n",
        "WHERE `Campaign Status` = 'active'\n",
        "GROUP BY ALL\n",
        "ORDER BY week\n"
      ]
    },
    {
      "name": "archetype",
      "displayName": "Traffic and delivery by site archetype (metric view)",
      "queryLines": [
        "SELECT `Site Archetype` AS archetype,\n",
        "       MEASURE(`Fuel Transactions`) / MEASURE(`Site Days`) AS avg_daily_transactions,\n",
        "       MEASURE(`Impressions`) / MEASURE(`Site Days`) AS avg_daily_impressions,\n",
        "       MEASURE(`Screen Uptime Pct`) / 100 AS uptime\n",
        "FROM metric_view_site_delivery\n",
        "WHERE `Campaign Status` = 'active'\n",
        "GROUP BY ALL\n",
        "ORDER BY avg_daily_transactions DESC\n"
      ]
    },
    {
      "name": "roi_model",
      "displayName": "ROI model",
      "queryLines": [
        "WITH at_risk AS (\n",
        "  SELECT campaign_id, campaign_name, cpm_rate, days_remaining,\n",
        "         shortfall_impressions AS shortfall_imp, shortfall_dollars AS shortfall_usd\n",
        "  FROM v_campaign_delivery\n",
        "  WHERE status = 'active' AND risk_level IN ('Critical', 'At Risk')\n",
        "),\n",
        "site_avg AS (\n",
        "  SELECT campaign_id, site_id, ROUND(SUM(impressions) / COUNT(DISTINCT impression_date)) AS avg_day\n",
        "  FROM v_campaign_site_daily\n",
        "  WHERE campaign_id IN (SELECT campaign_id FROM at_risk)\n",
        "  GROUP BY ALL\n",
        "),\n",
        "ranked AS (\n",
        "  SELECT *, ROW_NUMBER() OVER (PARTITION BY campaign_id ORDER BY avg_day, site_id) AS rn,\n",
        "         COUNT(*) OVER (PARTITION BY campaign_id) AS n\n",
        "  FROM site_avg\n",
        "),\n",
        "plan AS (\n",
        "  SELECT campaign_id,\n",
        "         SUM(CASE\n",
        "               WHEN rn > n - GREATEST(5, CEIL(n * 0.35)) THEN ROUND(avg_day * 1.4) - avg_day\n",
        "               WHEN rn <= LEAST(GREATEST(3, CEIL(n * 0.25)), GREATEST(n - GREATEST(5, CEIL(n * 0.35)), 0))\n",
        "                 THEN ROUND(avg_day * 0.5) - avg_day\n",
        "               ELSE 0\n",
        "             END) AS net_daily\n",
        "  FROM ranked\n",
        "  GROUP BY campaign_id\n",
        "),\n",
        "recovery AS (\n",
        "  SELECT a.campaign_name, a.shortfall_usd,\n",
        "         LEAST(GREATEST(p.net_daily * GREATEST(a.days_remaining, 0), 0), a.shortfall_imp) * a.cpm_rate / 1000 AS recovered_usd\n",
        "  FROM at_risk a JOIN plan p USING (campaign_id)\n",
        "),\n",
        "turns AS (\n",
        "  SELECT 365.0 / AVG(flight_days) AS per_year FROM v_campaign_delivery WHERE status = 'active'\n",
        ")\n",
        "SELECT 1 AS sort_order, 'Avoided make-goods (rebalance at-risk campaigns)' AS benefit, 'Demo data' AS basis,\n",
        "       ROUND(SUM(r.shortfall_usd)) AS current_exposure_usd,\n",
        "       ROUND(SUM(r.recovered_usd) / SUM(r.shortfall_usd), 3) AS recovery_rate,\n",
        "       ROUND(SUM(r.recovered_usd) * MAX(t.per_year)) AS annual_savings_usd,\n",
        "       CONCAT(COUNT(*), ' at-risk campaigns, $', FORMAT_NUMBER(SUM(r.shortfall_usd), 0),\n",
        "              ' exposure. One Suggest-plan rebalance each, using days remaining as of the demo date, recovers $',\n",
        "              FORMAT_NUMBER(SUM(r.recovered_usd), 0), '. x ', FORMAT_NUMBER(MAX(t.per_year), 1),\n",
        "              ' portfolio turns per year (365 / average flight length).') AS description\n",
        "FROM recovery r CROSS JOIN turns t\n",
        "UNION ALL\n",
        "SELECT 2, 'Analyst hours freed', 'Assumption (validate with the retail media team)', 2400 * 85, NULL, 2400 * 85,\n",
        "       '2,400 hours a year at $85 an hour loaded: self-serve answers through Genie and the dashboard instead of manual reporting. Not derived from the demo data.'\n",
        "ORDER BY sort_order\n"
      ]
    }
  ],
