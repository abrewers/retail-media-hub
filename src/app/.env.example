# Local development only (npm/pnpm run dev). Deployed apps get these from the bundle.
DATABRICKS_HOST=https://<your-workspace-host>
DATABRICKS_WAREHOUSE_ID=<your-warehouse-id>
RMCC_CATALOG=<your-catalog>
RMCC_SCHEMA=retail_media
LAKEBASE_ENDPOINT=projects/<lakebase-project>/branches/production/endpoints/primary
PGHOST=<lakebase-host>
PGDATABASE=databricks_postgres
PGPORT=5432
PGSSLMODE=require
DATABRICKS_APP_PORT=8000
